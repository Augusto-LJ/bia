        <!-- ECR → Tasks (pull de imagem) -->
        <mxCell id="edge-ecr-task-a" value="pull image" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#AD688F;strokeWidth=1.5;fontColor=#AD688F;fontSize=9;dashed=1;" edge="1" source="ecr" target="container-a" parent="aws-cloud">

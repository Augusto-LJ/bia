        <!-- CodeBuild → ECR -->
        <mxCell id="edge-build-ecr" value="docker push" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#FF9900;strokeWidth=2;fontColor=#FF9900;fontSize=10;" edge="1" source="codebuild" target="ecr" parent="aws-cloud">
          <mxGeometry relative="1" as="geometry" />

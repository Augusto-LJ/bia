        <!-- CodePipeline → CodeBuild -->
        <mxCell id="edge-pipeline-build" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#FF9900;strokeWidth=2;" edge="1" source="codepipeline" target="codebuild" parent="aws-cloud">

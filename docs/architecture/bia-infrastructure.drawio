        <!-- CodePipeline → ECS Service (deploy) -->
        <mxCell id="edge-pipeline-ecs" value="Rolling Update Deploy" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#FF9900;strokeWidth=2;fontColor=#FF9900;fontSize=10;" edge="1" source="codepipeline" target="ecs-service" parent="aws-cloud">
